    <DataTemplate DataType="{x:Type local:FilterOffsetCalculator}">
        <nina:SequenceBlockView DataContext="{Binding}">
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Iterations" />
                    <TextBox
                        MinWidth="40"
                        Margin="5,0,0,0"
                        Text="{Binding Loops}"
                        TextAlignment="Right" />
                    <Button
                        Width="75"
                        Margin="10,0,0,0"
                        Padding="5"
                        Command="{Binding SetUpFilters}">
                        <Button.Content>
                            <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="Settings" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
            <nina:SequenceBlockView.SequenceItemProgressContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Loop" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Progress}" />
                    <TextBlock VerticalAlignment="Center" Text=" / " />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Loops}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemProgressContent>
        </nina:SequenceBlockView>
    </DataTemplate>
    <DataTemplate x:Key="NINA.Plugin.DarksCustoms.Sequencer.SequenceItem.FilterOffsetCalculator_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding Text}" />
                </StackPanel>
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:FilterSelectionVM}">
        <StackPanel
            Width="400"
            Margin="5"
            Orientation="Vertical">
            <DataGrid
                Margin="5"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Disabled"
                ItemsSource="{Binding FilterWheelFilters}"
                VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="*"
                        CanUserSort="False"
                        Header="Calculate Offset">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="*"
                        CanUserSort="False"
                        Header="Position">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="5,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Filter.Position}"
                                    TextAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="*"
                        CanUserSort="False"
                        Header="Filter">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="5,0,5,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Filter.Name}"
                                    TextAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:FilterOffsetDialogVM}">
        <StackPanel
            Width="400"
            Margin="5"
            Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    MinHeight="20"
                    VerticalAlignment="Center"
                    Text="Current Offsets" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    MinHeight="20"
                    VerticalAlignment="Center"
                    Text="New Offsets" />
                <DataGrid
                    Grid.Row="1"
                    Grid.Column="0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Disabled"
                    ItemsSource="{Binding OldOffsets}"
                    VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Position">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Position}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Filter">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Offset">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding FocusOffset}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid
                    Grid.Row="1"
                    Grid.Column="1"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Disabled"
                    ItemsSource="{Binding NewOffsets}"
                    VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Position">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Position}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Filter">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            CanUserSort="False"
                            Header="Offset">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding FocusOffset}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    MinHeight="20"
                    VerticalAlignment="Center"
                    Text="Use Relative Offsets" />
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="1"
                    MinHeight="20"
                    IsChecked="{Binding UseRelativeOffsets, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    MinHeight="20"
                    VerticalAlignment="Center"
                    Text="Current AutoFocus Filter" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="{Binding OldDefaultFilter.Name}" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    MinHeight="20"
                    VerticalAlignment="Center"
                    Text="New AutoFocus Filter" />
                <ComboBox
                    Grid.Row="4"
                    Grid.Column="1"
                    MinHeight="20"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding OffsetsWithNull}"
                    SelectedItem="{Binding NewDefaultFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Height="50"
                    Margin="0,5,0,0"
                    util:ButtonHelper.DialogResult="True"
                    Command="{Binding OKCommand}">
                    <Button.Content>
                        <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="Accept" />
                    </Button.Content>
                </Button>
                <Button
                    Grid.Row="6"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Height="25"
                    Margin="0,5,0,0"
                    util:ButtonHelper.DialogResult="False"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource BackgroundButton}">
                    <Button.Content>
                        <TextBlock Foreground="{StaticResource PrimaryBrush}" Text="Abort" />
                    </Button.Content>
                </Button>
            </Grid>
        </StackPanel>
    </DataTemplate>


    <DataTemplate x:Key="NINA.Plugin.DarksCustoms.FilterOffsetCalculator.FilterOffsetCalculatorImagingTool_Dockable">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Iterations" />
                <TextBox
                    MinWidth="40"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Text="{Binding Calculator.Loops}"
                    TextAlignment="Right" />
            </StackPanel>
            <ninactrl:AsyncProcessButton
                x:Name="TheButton"
                Grid.Column="1"
                Width="135"
                Height="25"
                Margin="5,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ButtonImage="{StaticResource PlaySVG}"
                CancelButtonImage="{StaticResource StopSVG}"
                CancelCommand="{Binding CancelExecuteCommand}"
                Command="{Binding ExecuteCommand}" />

            <ItemsControl
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,5,0,0"
                ItemsSource="{Binding Calculator.Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Background="{StaticResource NotificationErrorBrush}"
                            Foreground="{StaticResource NotificationErrorTextBrush}"
                            Text="{Binding}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ContentPresenter
                Grid.Row="2"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Content="{Binding FilterSelection}"
                IsEnabled="{Binding DataContext.ExecuteCommand.Execution.IsCompleted, FallbackValue=True, ElementName=TheButton}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>